
[KDE]
contrast=4

[General]
ColorScheme=Matugen
Name=Matugen

# Disabled widgets: desaturate and fade toward the background rather than darken.
[ColorEffects:Disabled]
Color={{colors.outline_variant.default.red}},{{colors.outline_variant.default.green}},{{colors.outline_variant.default.blue}}
ColorAmount=0.3
ColorEffect=1
ContrastAmount=0.5
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

# Content wells (lists, text fields): a low container tone, a clearly visible step darker than the
# chrome so content sits sunken below it. Zebra striping is one tonal step.
[Colors:View]
BackgroundAlternate={{colors.surface_container.default.red}},{{colors.surface_container.default.green}},{{colors.surface_container.default.blue}}
BackgroundNormal={{colors.surface_container_low.default.red}},{{colors.surface_container_low.default.green}},{{colors.surface_container_low.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
ForegroundNegative={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}
ForegroundNeutral={{colors.warning.default.red}},{{colors.warning.default.green}},{{colors.warning.default.blue}}
ForegroundNormal={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}
ForegroundPositive={{colors.success.default.red}},{{colors.success.default.green}},{{colors.success.default.blue}}
ForegroundVisited={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

# Window chrome (sidebars, panes): a high container tone.
[Colors:Window]
BackgroundAlternate={{colors.surface_container_highest.default.red}},{{colors.surface_container_highest.default.green}},{{colors.surface_container_highest.default.blue}}
BackgroundNormal={{colors.surface_container_high.default.red}},{{colors.surface_container_high.default.green}},{{colors.surface_container_high.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
ForegroundNegative={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}
ForegroundNeutral={{colors.warning.default.red}},{{colors.warning.default.green}},{{colors.warning.default.blue}}
ForegroundNormal={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}
ForegroundPositive={{colors.success.default.red}},{{colors.success.default.green}},{{colors.success.default.blue}}
ForegroundVisited={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

# Buttons use the secondary container so they read as raised, with its paired on-color for text.
# Secondary is desaturated, so buttons don't compete with the primary accent.
[Colors:Button]
BackgroundAlternate={{colors.surface_container_highest.default.red}},{{colors.surface_container_highest.default.green}},{{colors.surface_container_highest.default.blue}}
BackgroundNormal={{colors.secondary_container.default.red}},{{colors.secondary_container.default.green}},{{colors.secondary_container.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
ForegroundNegative={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}
ForegroundNeutral={{colors.warning.default.red}},{{colors.warning.default.green}},{{colors.warning.default.blue}}
ForegroundNormal={{colors.on_secondary_container.default.red}},{{colors.on_secondary_container.default.green}},{{colors.on_secondary_container.default.blue}}
ForegroundPositive={{colors.success.default.red}},{{colors.success.default.green}},{{colors.success.default.blue}}
ForegroundVisited={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

# Toolbars and headers: one step above the window.
[Colors:Header]
BackgroundAlternate={{colors.surface_container_high.default.red}},{{colors.surface_container_high.default.green}},{{colors.surface_container_high.default.blue}}
BackgroundNormal={{colors.surface_container_highest.default.red}},{{colors.surface_container_highest.default.green}},{{colors.surface_container_highest.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
ForegroundNegative={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}
ForegroundNeutral={{colors.warning.default.red}},{{colors.warning.default.green}},{{colors.warning.default.blue}}
ForegroundNormal={{colors.on_surface.default.red}},{{colors.on_surface.default.green}},{{colors.on_surface.default.blue}}
ForegroundPositive={{colors.success.default.red}},{{colors.success.default.green}},{{colors.success.default.blue}}
ForegroundVisited={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

# Inactive headers drop a tonal step and use secondary-level text so they recede.
[Colors:Header][Inactive]
BackgroundAlternate={{colors.surface_container.default.red}},{{colors.surface_container.default.green}},{{colors.surface_container.default.blue}}
BackgroundNormal={{colors.surface_container_high.default.red}},{{colors.surface_container_high.default.green}},{{colors.surface_container_high.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundInactive={{colors.outline.default.red}},{{colors.outline.default.green}},{{colors.outline.default.blue}}
ForegroundLink={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
ForegroundNegative={{colors.error.default.red}},{{colors.error.default.green}},{{colors.error.default.blue}}
ForegroundNeutral={{colors.warning.default.red}},{{colors.warning.default.green}},{{colors.warning.default.blue}}
ForegroundNormal={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundPositive={{colors.success.default.red}},{{colors.success.default.green}},{{colors.success.default.blue}}
ForegroundVisited={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}

# Selection uses the primary container (not the full primary) so large selected areas are not glaring.
# Semantic text uses on-*-container colors, which are tinted but guaranteed legible on it.
[Colors:Selection]
BackgroundAlternate={{colors.secondary_container.default.red}},{{colors.secondary_container.default.green}},{{colors.secondary_container.default.blue}}
BackgroundNormal={{colors.primary_container.default.red}},{{colors.primary_container.default.green}},{{colors.primary_container.default.blue}}
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundActive={{colors.on_primary_container.default.red}},{{colors.on_primary_container.default.green}},{{colors.on_primary_container.default.blue}}
ForegroundInactive={{colors.on_surface_variant.default.red}},{{colors.on_surface_variant.default.green}},{{colors.on_surface_variant.default.blue}}
ForegroundLink={{colors.on_tertiary_container.default.red}},{{colors.on_tertiary_container.default.green}},{{colors.on_tertiary_container.default.blue}}
ForegroundNegative={{colors.on_error_container.default.red}},{{colors.on_error_container.default.green}},{{colors.on_error_container.default.blue}}
ForegroundNeutral={{colors.on_warning_container.default.red}},{{colors.on_warning_container.default.green}},{{colors.on_warning_container.default.blue}}
ForegroundNormal={{colors.on_primary_container.default.red}},{{colors.on_primary_container.default.green}},{{colors.on_primary_container.default.blue}}
ForegroundPositive={{colors.on_success_container.default.red}},{{colors.on_success_container.default.green}},{{colors.on_success_container.default.blue}}
ForegroundVisited={{colors.on_secondary_container.default.red}},{{colors.on_secondary_container.default.green}},{{colors.on_secondary_container.default.blue}}

# Tooltips follow the Material inverse-surface pattern. The *_container roles invert with the
# scheme, so they stay readable on the inverse background in both dark and light mode.
[Colors:Tooltip]
BackgroundAlternate={{colors.inverse_surface.default.red}},{{colors.inverse_surface.default.green}},{{colors.inverse_surface.default.blue}}
BackgroundNormal={{colors.inverse_surface.default.red}},{{colors.inverse_surface.default.green}},{{colors.inverse_surface.default.blue}}
DecorationFocus={{colors.inverse_primary.default.red}},{{colors.inverse_primary.default.green}},{{colors.inverse_primary.default.blue}}
DecorationHover={{colors.inverse_primary.default.red}},{{colors.inverse_primary.default.green}},{{colors.inverse_primary.default.blue}}
ForegroundActive={{colors.inverse_primary.default.red}},{{colors.inverse_primary.default.green}},{{colors.inverse_primary.default.blue}}
ForegroundInactive={{colors.outline_variant.default.red}},{{colors.outline_variant.default.green}},{{colors.outline_variant.default.blue}}
ForegroundLink={{colors.tertiary_container.default.red}},{{colors.tertiary_container.default.green}},{{colors.tertiary_container.default.blue}}
ForegroundNegative={{colors.error_container.default.red}},{{colors.error_container.default.green}},{{colors.error_container.default.blue}}
ForegroundNeutral={{colors.warning_container.default.red}},{{colors.warning_container.default.green}},{{colors.warning_container.default.blue}}
ForegroundNormal={{colors.inverse_on_surface.default.red}},{{colors.inverse_on_surface.default.green}},{{colors.inverse_on_surface.default.blue}}
ForegroundPositive={{colors.success_container.default.red}},{{colors.success_container.default.green}},{{colors.success_container.default.blue}}
ForegroundVisited={{colors.secondary_container.default.red}},{{colors.secondary_container.default.green}},{{colors.secondary_container.default.blue}}

# Panels/OSDs: this group is meant to stay dark in any mode, so it always uses the dark variants.
[Colors:Complementary]
BackgroundAlternate={{colors.surface_container.dark.red}},{{colors.surface_container.dark.green}},{{colors.surface_container.dark.blue}}
BackgroundNormal={{colors.surface_container_low.dark.red}},{{colors.surface_container_low.dark.green}},{{colors.surface_container_low.dark.blue}}
DecorationFocus={{colors.primary.dark.red}},{{colors.primary.dark.green}},{{colors.primary.dark.blue}}
DecorationHover={{colors.secondary.dark.red}},{{colors.secondary.dark.green}},{{colors.secondary.dark.blue}}
ForegroundActive={{colors.primary.dark.red}},{{colors.primary.dark.green}},{{colors.primary.dark.blue}}
ForegroundInactive={{colors.on_surface_variant.dark.red}},{{colors.on_surface_variant.dark.green}},{{colors.on_surface_variant.dark.blue}}
ForegroundLink={{colors.tertiary.dark.red}},{{colors.tertiary.dark.green}},{{colors.tertiary.dark.blue}}
ForegroundNegative={{colors.error.dark.red}},{{colors.error.dark.green}},{{colors.error.dark.blue}}
ForegroundNeutral={{colors.warning.dark.red}},{{colors.warning.dark.green}},{{colors.warning.dark.blue}}
ForegroundNormal={{colors.on_surface.dark.red}},{{colors.on_surface.dark.green}},{{colors.on_surface.dark.blue}}
ForegroundPositive={{colors.success.dark.red}},{{colors.success.dark.green}},{{colors.success.dark.blue}}
ForegroundVisited={{colors.secondary.dark.red}},{{colors.secondary.dark.green}},{{colors.secondary.dark.blue}}

